{
	"name": "oriso-addon-beratungstools",
	"version": "0.1.0",
	"private": true,
	"description": "The digital counselling tools of DigiSucht as one ORISO add-on",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node server/src/main.ts",
		"build": "vite build",
		"preview": "node web/dev/preview.ts",
		"typecheck": "tsc -p server && tsc -p web",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run --project server --project web",
		"test:integration": "vitest run --project integration",
		"db:up": "docker compose up -d --wait mariadb"
	},
	"dependencies": {
		"@fastify/static": "^10.1.12",
		"dejavu-fonts-ttf": "^2.37.3",
		"fastify": "^5.12.8",
		"mariadb": "^3.5.5",
		"pdfkit": "^0.21.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oriso/vite-plugin-addon": "file:tooling/vite-plugin-oriso-addon",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.0.0",
		"@types/pdfkit": "^0.17.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
